# Copy to .env and adjust for your environment.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Defaults to a local SQLite file. Point at Postgres in production:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/healthforecast
DATABASE_URL=sqlite:///./app/data/healthforecast.db
