# ---------------------------------------------------------------------------
# HealthForecast AI - Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# App
APP_NAME=HealthForecast AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://healthforecast:healthforecast@db:5432/healthforecast_db
POSTGRES_USER=healthforecast
POSTGRES_PASSWORD=healthforecast
POSTGRES_DB=healthforecast_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ML Model
MODEL_PATH=ml/best_xgboost.pkl
MODEL_VERSION=1.0.0

# Reports
REPORTS_DIR=generated_reports

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
